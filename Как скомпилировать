# 1. Установить Haxe 4.3.6
curl -L https://github.com/HaxeFoundation/haxe/releases/download/4.3.6/haxe-4.3.6-linux64.tar.gz -o haxe.tar.gz
tar xf haxe.tar.gz -C ~/ && rm haxe.tar.gz
export PATH="$HOME/haxe_4.3.6:$PATH"

# 2. Инициализировать Haxelib
haxelib setup ~/haxelib

# 3. Установить основные зависимости (как в workflow)
haxelib install hxcpp --skip-dependencies
haxelib install lime 8.1.3 --skip-dependencies
haxelib install openfl 9.3.4 --skip-dependencies
haxelib install flixel 5.6.2 --skip-dependencies
haxelib install flixel-addons 3.2.3 --skip-dependencies
haxelib install flixel-ui 2.6.1 --skip-dependencies

# 4. Установить Android расширения
haxelib install extension-androidtools --skip-dependencies
haxelib git extension-orientation https://github.com/HaxeExtension/extension-orientation --skip-dependencies
haxelib git extension-haptics https://github.com/LimeExtensions/extension-haptics --skip-dependencies

# 5. Другие библиотеки
haxelib install format --skip-dependencies
haxelib install hxp --skip-dependencies
haxelib install thx.semver --skip-dependencies
haxelib install polymod --skip-dependencies
haxelib git flxanimate https://github.com/Redar13/flxanimate dev --skip-dependencies
haxelib git linc_luajit https://github.com/superpowers04/linc_luajit --skip-dependencies
haxelib git hscript-improved https://github.com/Redar13/hscript-improved polymod-scripted-classes --skip-dependencies
haxelib install hxvlc --skip-dependencies
haxelib install hxdiscord_rpc --skip-dependencies
haxelib install funk.vis --skip-dependencies
haxelib install grig.audio --skip-dependencies
haxelib install haxeui-core 1.7.0 --skip-dependencies
haxelib install haxeui-openfl 1.7.0 --skip-dependencies
haxelib install hxcpp-debug-server --skip-dependencies

# 6. Скачать Android SDK/NDK (если еще нет)
# Linux: экспортируй переменные или установи Android Studio

# 7. Настроить Lime для Android
export ANDROID_SDK=/path/to/android/sdk
export ANDROID_NDK_ROOT=/path/to/android/ndk/21.4.7075529

haxelib run lime config ANDROID_SDK $ANDROID_SDK
haxelib run lime config ANDROID_NDK_ROOT $ANDROID_NDK_ROOT
haxelib run lime setup android

# 8. Собрать проект (debug версию)
cd /path/to/5-Rubles-Mobile
haxelib run lime build android -debug

# Или release версию
haxelib run lime build -release android
